---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import AppCard from "../components/AppCard.astro";
import HeroCard from "../components/HeroCard.astro";
import { getCategoriesWithRandomApps, getAppConfig } from "../lib/query";
import { getApps } from "../lib/data";
import { getInstallCounts, getAppInstallCount } from "../lib/stats";
import { getCurrentLanguage, getLocalizedStrings } from "../lib/i18n";

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=1800');

const allApps = getApps();


const categoryApps = getCategoriesWithRandomApps(4);
const categoryCounts: Record<string, number> = {};
for (const app of allApps) {
  for (const cat of app.categories) {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1
  }
}
const categories = Object.keys(categoryApps).sort((a, b) => (categoryCounts[b] || 0) - (categoryCounts[a] || 0));

const installCounts = await getInstallCounts();
const popularApps = [...allApps]
  .filter((app) => getAppInstallCount(app, installCounts) > 0)
  .sort((a, b) => getAppInstallCount(b, installCounts) - getAppInstallCount(a, installCounts))
  .slice(0, 18);

const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);
---

<Layout>
  <div class="container mx-auto px-4 py-6">
    <HeroCard currentLanguage={currentLanguage} />

    <!-- Popular apps card -->
    <div class="mb-8">
      <div class="p-5 md:p-6 border border-border rounded-3xl">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold text-text">
            {translations["popular"]}
          </h2>
          <button
            type="button"
            data-action="toggle-popular"
            aria-expanded="false"
            aria-controls="popular-grid"
            class="group shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-surface-hover border border-border text-text-subtle hover:text-primary-400 hover:border-primary-500 transition-all duration-200"
          >
            <svg class="w-4 h-4 transition-transform duration-300 group-data-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div id="popular-grid" data-popular-grid class="group/grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 2xl:grid-cols-3 gap-4">
          {popularApps.map((app, index) => (
            <div
              data-popular-item
              data-extra={index >= 6 ? "true" : undefined}
              class:list={[index >= 6 && "hidden"]}
            >
              <AppCard
                app={app}
                translations={translations}
                currentLanguage={currentLanguage}
                hideCategories={true}
                installCount={getAppInstallCount(app, installCounts)}
                compact={true}
              />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Categories card -->
    <div class="mb-8">
      <div class="p-5 md:p-6 border border-border rounded-3xl">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold text-text">
            {translations["categories"]}
          </h2>
          <button
            type="button"
            data-action="toggle-categories"
            aria-expanded="false"
            aria-controls="category-grid"
            class="group shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-surface-hover border border-border text-text-subtle hover:text-primary-400 hover:border-primary-500 transition-all duration-200"
          >
            <svg class="w-4 h-4 transition-transform duration-300 group-data-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
        <div id="category-grid" data-category-grid class="group/grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4">
          {
            categories.map((cat: string, index: number) => (
              <a
                href={`/apps?category=${cat}`}
                data-category-item
                data-extra={index >= 12 ? "true" : undefined}
                class:list={[
                  "group relative block p-4 bg-surface border border-border rounded-3xl hover:border-primary-500 transition-all duration-300",
                  index >= 12 && "hidden",
                ]}
              >
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-sm font-semibold text-text">
                    {translations[cat]}
                  </h3>
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs text-text-subtle">{categoryCounts[cat]}</span>
                    <svg
                      class="w-3.5 h-3.5 text-text-subtle group-hover:text-primary-400 group-hover:translate-x-0.5 transition-all duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2">
                  {categoryApps[cat].map((app) => (
                    <Icon
                      src={app.icon}
                      alt={getAppConfig(app)[0].name}
                      width={32}
                      height={32}
                      className="rounded-xl opacity-80 group-hover:opacity-100 transition-opacity duration-300"
                    />
                  ))}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Card collapse script -->
  <script>
    const grid = document.querySelector<HTMLElement>("[data-category-grid]");
    const button = document.querySelector<HTMLButtonElement>('[data-action="toggle-categories"]');
    if (grid && button) {
      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!expanded));
        if (expanded) {
          button.removeAttribute("data-expanded");
        } else {
          button.setAttribute("data-expanded", "true");
        }
        grid.querySelectorAll<HTMLElement>("[data-extra='true']").forEach((item) => {
          item.classList.toggle("hidden", expanded);
        });
      });
    }

    const popularGrid = document.querySelector<HTMLElement>("[data-popular-grid]");
    const popularButton = document.querySelector<HTMLButtonElement>('[data-action="toggle-popular"]');
    if (popularGrid && popularButton) {
      popularButton.addEventListener("click", () => {
        const expanded = popularButton.getAttribute("aria-expanded") === "true";
        popularButton.setAttribute("aria-expanded", String(!expanded));
        if (expanded) {
          popularButton.removeAttribute("data-expanded");
        } else {
          popularButton.setAttribute("data-expanded", "true");
        }
        popularGrid.querySelectorAll<HTMLElement>("[data-extra='true']").forEach((item) => {
          item.classList.toggle("hidden", expanded);
        });
      });
    }
  </script>
</Layout>
