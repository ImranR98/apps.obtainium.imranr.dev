---
import Icon from "./Icon.astro";
import { getAppConfig, getAppConfigString } from "../lib/query";
import { pickLocalTranslation } from "../lib/i18n";
import type { SimpleApp, ComplexApp, ComplexAppConfig } from "../lib/types";

interface Props {
  app: SimpleApp | ComplexApp;
  translations: Record<string, string>;
  currentLanguage: string;
  hideCategories?: boolean;
  installCount?: number;
  compact?: boolean;
}

const { app, translations, currentLanguage, hideCategories = false, installCount = 0, compact = false } =
  Astro.props;
const appConfigs = getAppConfig(app);
---

{
  compact ? (
    <div
      class="group relative bg-surface border border-border rounded-3xl p-3 hover:border-border-hover transition-all duration-200 flex items-center gap-3"
    >
      <Icon
        src={app.icon}
        alt={appConfigs[0].name}
        width={32}
        height={32}
        className="rounded-xl shrink-0"
      />
      <div class="min-w-0 flex-1">
        <h3 class="text-sm font-semibold text-text truncate">
          <a
            href={appConfigs[0].url}
            class="hover:text-primary-500 transition-colors"
            >{appConfigs[0].name}</a
          >
        </h3>
        <p class="text-text-subtle text-xs truncate">
          by {appConfigs[0].author}
        </p>
      </div>
      {installCount > 0 && (
        <span class="text-text-muted text-xs font-medium whitespace-nowrap">
          {new Intl.NumberFormat(undefined, { notation: "compact", maximumFractionDigits: 1 }).format(installCount)}
          {" "}{translations["monthlyInstalls"]}
        </span>
      )}
      {
        appConfigs.length > 1 ? (
          <details class="variant-picker relative shrink-0">
            <summary
              class="cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none px-3 py-1.5 bg-primary-600 text-on-primary text-xs font-medium rounded-full hover:bg-primary-500 transition-colors duration-200 text-center"
            >
              {translations["install"]}
            </summary>
            <div
              class="absolute right-0 top-full mt-2 z-20 w-64 bg-surface border border-border rounded-2xl p-2 shadow-xl"
            >
              <p class="text-text-muted text-xs px-2 pt-1 pb-2">
                {translations["chooseVariant"]}
              </p>
              {appConfigs.map((c, index) => (
                <a
                  class="flex items-center justify-between px-2 py-1.5 rounded-lg hover:bg-surface-hover transition-colors"
                  href={`obtainium://app/${encodeURIComponent(getAppConfigString(app, currentLanguage, index))}`}
                >
                  <span class="text-xs font-medium text-text truncate">{(c as ComplexAppConfig).altLabel || c.name}</span>
                  <svg class="w-3 h-3 text-text-subtle shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            class="shrink-0 px-3 py-1.5 bg-primary-600 text-on-primary text-xs font-medium rounded-full hover:bg-primary-500 transition-colors duration-200 text-center"
            href={`obtainium://app/${encodeURIComponent(getAppConfigString(app, currentLanguage, 0))}`}
          >
            {translations["install"]}
          </a>
        )
      }
    </div>
  ) : (
    <div
      class="group relative bg-surface border border-border rounded-3xl p-4 hover:border-border-hover transition-all duration-200 flex flex-col h-full"
    >
  <div class="flex items-start mb-3">
    <Icon
      src={app.icon}
      alt={appConfigs[0].name}
      width={44}
      height={44}
      className="mr-3 rounded-xl"
    />
    <div class="min-w-0 flex-1">
      <h3 class="text-sm font-semibold text-text truncate">
        <a
          href={appConfigs[0].url}
          class="hover:text-primary-500 transition-colors"
          >{appConfigs[0].name}</a
        >
      </h3>
      <p class="text-text-subtle text-xs truncate mt-0.5">
        by {appConfigs[0].author}
        {app.homepage && (
          <>
            {" "}•{" "}
            <a
              href={app.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-400 hover:text-primary-300 hover:underline transition-colors"
            >
              {translations["homepage"]}
            </a>
          </>
        )}
      </p>
    </div>
    {appConfigs.length > 1 && (appConfigs[0] as ComplexAppConfig).altLabel && (
      <span
        class="px-2 py-0.5 bg-surface-hover text-text-muted text-xs font-medium rounded-lg border border-border-hover"
      >
        {(appConfigs[0] as ComplexAppConfig).altLabel}
      </span>
    )}
  </div>

  <p class="text-text-muted text-sm mb-3 line-clamp-2">
    {pickLocalTranslation(app.description, currentLanguage)}
  </p>

  {!hideCategories && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {app.categories.map((cat: string) => (
        <span
          class="px-2 py-0.5 bg-primary-50/80 text-primary-700 text-xs font-medium rounded-lg"
        >
          {translations[cat]}
        </span>
      ))}
    </div>
  )}

  <div class="mt-auto pt-3">
    {installCount > 0 && (
      <div class="flex items-center mb-3 text-text-muted">
        <svg class="w-4 h-4 mr-1.5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
        <span class="text-xs font-medium">{new Intl.NumberFormat(undefined, { notation: "compact", maximumFractionDigits: 1 }).format(installCount)} {translations["monthlyInstalls"]}</span>
      </div>
    )}
    <div class="flex gap-2">
      <button
        type="button"
        class="jsonly flex-1 px-3 py-2 bg-surface-hover text-text-secondary text-sm font-medium rounded-full hover:bg-surface-alt transition-colors duration-200"
        onclick={`copyToClipboard(${JSON.stringify(getAppConfigString(app, currentLanguage, 0))})`}
      >
        {translations["copy"]}
      </button>
      <a
        class="flex-1 px-3 py-2 bg-primary-600 text-on-primary text-sm font-medium rounded-full hover:bg-primary-500 transition-colors duration-200 text-center"
        href={`obtainium://app/${encodeURIComponent(getAppConfigString(app, currentLanguage, 0))}`}
      >
        {translations["install"]}
      </a>
    </div>
    {appConfigs.length > 1 && (
      <div class="space-y-2 pt-3 mt-3 border-t border-border">
        {appConfigs.slice(1).map((c: ComplexAppConfig, index: number) => (
          <div class="flex items-center justify-between">
            <span
              class="px-2 py-0.5 bg-surface-hover text-text-muted text-xs font-medium rounded-lg border border-border-hover"
            >
              {c.altLabel || c.name}
            </span>
            <div class="flex gap-1.5">
              <button
                type="button"
                class="jsonly px-2.5 py-1.5 bg-surface-hover text-text-secondary text-xs font-medium rounded-full hover:bg-surface-alt transition-colors duration-200"
                onclick={`copyToClipboard(${JSON.stringify(getAppConfigString(app, currentLanguage, index + 1))})`}
              >
                {translations["copy"]}
              </button>
              <a
                class="px-2.5 py-1.5 bg-primary-600 text-on-primary text-xs font-medium rounded-full hover:bg-primary-500 transition-colors duration-200"
                href={`obtainium://app/${encodeURIComponent(getAppConfigString(app, currentLanguage, index + 1))}`}
              >
                {translations["install"]}
              </a>
            </div>
          </div>
        ))}
      </div>
    )}
    </div>
  </div>
  )
}

<script>
  document.addEventListener("click", (e) => {
    if ((e.target as Element | null)?.closest(".variant-picker")) return;
    document.querySelectorAll<HTMLDetailsElement>(".variant-picker[open]").forEach((d) => {
      d.removeAttribute("open");
    });
  });
</script>
