---
import { getLocalizedStrings } from "../lib/i18n";

const { currentLanguage = "en", compact = false } = Astro.props;
const translations = getLocalizedStrings(currentLanguage);
---

<section class={`hero relative overflow-hidden bg-surface border border-border ${compact ? "rounded-3xl" : "rounded-3xl"} mb-8`}>
  <div class="hero-glow absolute -top-32 -right-24 w-96 h-96 bg-primary-600/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="relative p-6 md:p-10">
    <div class="max-w-2xl">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-text leading-tight">
        {translations["subtitle"]}
      </h1>

      <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
              {translations["heroDescription"]}
      </p>


      {!compact && (
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-2 gap-3">
          <a href="/apps" class="hero-feature group flex items-center gap-3 p-3.5 rounded-2xl bg-surface-hover border border-border hover:border-primary-500 hover:-translate-y-0.5 transition-all duration-200">
            <span class="shrink-0 w-9 h-9 rounded-xl bg-primary-50/80 flex items-center justify-center">
                        <svg class="w-7 h-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128H6m12 0A2.25 2.25 0 0118.75 9v.878M6 6.878a2.25 2.25 0 00-.878.5L3.22 9.22a2.25 2.25 0 00-.47 2.372L4.5 18.5a2.25 2.25 0 002.121 1.5h10.758a2.25 2.25 0 002.121-1.5l1.748-6.908a2.25 2.25 0 00-.47-2.372l-1.902-1.842a2.25 2.25 0 00-.878-.5M6 6.878V6h12v.878" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-text group-hover:text-primary-400 transition-colors">{translations["browseAllApps"]}</span>
                            <span class="block text-xs text-text-subtle truncate">{translations["browseAllAppsHint"]}</span>
            </span>
          </a>
          <a href="/categories/" class="hero-feature group flex items-center gap-3 p-3.5 rounded-2xl bg-surface-hover border border-border hover:border-primary-500 hover:-translate-y-0.5 transition-all duration-200">
            <span class="shrink-0 w-9 h-9 rounded-xl bg-primary-50/80 flex items-center justify-center">
                        <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M4 4h6v6h-6l0 -6" />
                                        <path d="M14 4h6v6h-6l0 -6" />
                                        <path d="M4 14h6v6h-6l0 -6" />
                                        <path d="M14 17a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-text group-hover:text-primary-400 transition-colors">{translations["categories"]}</span>
                            <span class="block text-xs text-text-subtle truncate">{translations["filterByCategory"]}</span>
            </span>
          </a>

        </div>
    <div class="mt-6 flex flex-wrap gap-2.5">
      <a
        href="https://github.com/ImranR98/Obtainium/releases/latest"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 text-on-primary text-sm font-medium rounded-full hover:bg-primary-500 active:scale-[0.97] transition-all duration-200"
      >
        {translations["downloadObtainium"]}
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

    </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-glow {
    animation: hero-glow-drift 12s ease-in-out infinite alternate;
  }
  @keyframes hero-glow-drift {
    from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.7; }
    to { transform: translate3d(-40px, 30px, 0) scale(1.15); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow { animation: none; }
  }
</style>
