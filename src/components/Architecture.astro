---
import { pickLocalTranslation } from "../lib/i18n";
import { getStrings } from "../lib/data";

interface Props {
  language?: string;
}

const { language = "en" } = Astro.props;
const strings = getStrings();
const architectureLabel =
  pickLocalTranslation(strings.yourArchitecture, language) ??
  "Your architecture";
---

<div class="flex justify-end mb-2">
  <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-hover border border-border-hover text-xs font-medium rounded-full text-text-secondary hover:text-text hover:border-border transition-all duration-200">
    <span class="font-semibold">{architectureLabel}:</span>
    <span class="device-architecture">...</span>
  </div>
</div>

<script is:inline>
  (() => {
    var ua = navigator.userAgent;
    var arch = "-";
    if (/x86_64|x64|amd64|WOW64/i.test(ua)) arch = "x86_64";
    else if (/arm64|aarch64/i.test(ua)) arch = "arm64(v8)";
    else if (/i[3-6]86|x86/i.test(ua)) arch = "x86";
    else if (/arm|aarch32/i.test(ua)) arch = "armv7";
    var elements = document.querySelectorAll(".device-architecture");
    elements.forEach(function (el) {
      el.textContent = arch;
    });
  })();
</script>
