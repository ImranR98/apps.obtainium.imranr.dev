{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "security:minimumReleaseAgeNpm"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "automerge": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates only when the required test check passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Batch non-major npm updates; majors stay separate and manual",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "npm dependencies (non-major)"
    },
    {
      "description": "Batch non-major pre-commit hook updates; majors stay separate and manual",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "pre-commit hooks (non-major)"
    },
    {
      "description": "Group Docker base image pins and digest refreshes",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "Docker base images"
    },
    {
      "description": "Group non-major GitHub Actions updates; majors stay separate and manual",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "description": "Major updates always stay manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Auto-merge major updates after the full test gate passes",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "ignoreTests": false
    }
  ]
}
